  "description": "TroupeChat 服务端（TypeScript）——troupejs Virtual Actor 框架实现，WebSocket 协议与 troupe-chat（Crystal）一致",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
